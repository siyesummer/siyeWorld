# GitHub Pages 项目站点构建配置：yarn build:pages 会读取本文件。
# 站点地址为 https://siyesummer.github.io/siyeWorld/，资源必须带仓库路径前缀。
NODE_ENV=production
VUE_APP_PUBLIC_PATH=/siyeWorld/

# GitHub Pages 无法配置服务端 history 回退，必须使用 hash 路由。
VUE_APP_ROUTER_MODE=hash

# GitHub Pages 通过正式 HTTPS 独立域名访问生产服务。
# 服务端 CORS Origin 必须允许 https://siyesummer.github.io。
VUE_APP_MUSIC_API_BASE_URL=https://music-api.siyes.cn
VUE_APP_SOCKET_URL=https://socket.siyes.cn
VUE_APP_CHAT_HISTORY_API_BASE_URL=https://linux-api.siyes.cn
VUE_APP_LOG_SERVER_BASE_URL=https://linux-api.siyes.cn
