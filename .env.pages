# GitHub Pages 项目站点构建配置：yarn build:pages 会读取本文件。
# 站点地址为 https://siyesummer.github.io/siyeWorld/，资源必须带仓库路径前缀。
NODE_ENV=production
VUE_APP_PUBLIC_PATH=/siyeWorld/

# GitHub Pages 无法配置服务端 history 回退，必须使用 hash 路由。
VUE_APP_ROUTER_MODE=hash

# 当前仍复用第七套 IP:8090 演练入口。
# 注意：GitHub Pages 是 HTTPS，而以下服务是 HTTP，浏览器会按 Mixed Content 拦截业务请求。
# 当前 Pages 制品只能验证静态页面、资源和 hash 路由，不能完成音乐、Socket.IO、聊天和日志联调。
VUE_APP_MUSIC_API_BASE_URL=http://106.52.222.106:8090/music-api
VUE_APP_SOCKET_URL=http://106.52.222.106:8090
VUE_APP_CHAT_HISTORY_API_BASE_URL=http://106.52.222.106:8090
VUE_APP_LOG_SERVER_BASE_URL=http://106.52.222.106:8090
