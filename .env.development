# 本地开发环境：yarn serve 会由 Vue CLI 自动读取本文件。

# 开发服务器从域名根路径提供资源，使用 history 路由。
VUE_APP_PUBLIC_PATH=/
VUE_APP_ROUTER_MODE=history

# 本地网易云音乐 API 服务。
VUE_APP_MUSIC_API_BASE_URL=http://localhost:3000

# 本地 easy-chat Socket.IO 服务；客户端会自动请求 /socket.io。
VUE_APP_SOCKET_URL=http://localhost:3030

# 本地 linux-server 聊天消息保存与历史查询服务。
VUE_APP_CHAT_HISTORY_API_BASE_URL=http://localhost:8081

# 本地 linux-server 日志查询服务。
VUE_APP_LOG_SERVER_BASE_URL=http://localhost:8081
