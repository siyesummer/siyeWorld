# 部署使用的 Docker Hub 固定版本镜像；正式环境不要使用 latest。
EASY_CHAT_IMAGE=siyesummer/easy-chat:0.0.2

# 宿主机绑定地址：127.0.0.1 只允许本机/Nginx 访问，0.0.0.0 才允许公网直连。
EASY_CHAT_BIND_ADDRESS=127.0.0.1

# 宿主机临时映射端口，容器内部端口固定为 3030。
EASY_CHAT_HOST_PORT=3130

# easy-chat 容器内部监听端口，必须与端口映射目标一致。
EASY_CHAT_CONTAINER_PORT=3030

# 允许访问 Socket.IO 的浏览器 Origin，多个值使用英文逗号分隔。
EASY_CHAT_CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://203.0.113.10:8090,https://music.siyes.cn

# 启用双写日志时的容器内路径；不配置时只输出 Docker stdout/stderr。
EASY_CHAT_LOG_FILE=/var/log/siye/socket.log
EASY_CHAT_ERROR_LOG_FILE=/var/log/siye/socket-error.log
EASY_CHAT_LOG_DIR=/var/log/siye-production
