# 当前准生产演练构建环境：yarn build 和前端镜像发布 Workflow 使用本文件。
# 域名仍在备案，本阶段统一通过 Linux edge-nginx 的 IP:端口入口完成真实业务验证。
# 备案和 HTTPS 完成后，再把本文件切换为三个独立 HTTPS 服务域名并发布新的镜像版本。

# Linux Nginx 容器从域名根路径提供资源，支持 history 路由回退。
VUE_APP_PUBLIC_PATH=/
VUE_APP_ROUTER_MODE=history

# edge-nginx 会把 /music-api 前缀移除后转发到 music-api。
VUE_APP_MUSIC_API_BASE_URL=http://106.52.222.106:8090/music-api

# Socket.IO 客户端会自动请求当前地址下的 /socket.io。
VUE_APP_SOCKET_URL=http://106.52.222.106:8090

# 聊天历史会追加 /api/chat/messages。
VUE_APP_CHAT_HISTORY_API_BASE_URL=http://106.52.222.106:8090

# 日志查询会追加 /api/logs/query。
VUE_APP_LOG_SERVER_BASE_URL=http://106.52.222.106:8090
