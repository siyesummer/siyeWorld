# 正式 Docker 构建环境：yarn build 和前端镜像发布 Workflow 使用本文件。
# siyes.cn 备案已经通过；正式候选镜像通过三个独立 HTTPS 服务域名访问 Linux 后端。
# 当前服务器仍运行 IP:8090 演练镜像，只有完整 Docker/HTTPS 验收通过后才切换正式流量。

# Linux Nginx 容器从域名根路径提供资源，支持 history 路由回退。
VUE_APP_PUBLIC_PATH=/
VUE_APP_ROUTER_MODE=history

# 网易云音乐 API 正式独立域名。
VUE_APP_MUSIC_API_BASE_URL=https://music-api.siyes.cn

# Socket.IO 客户端会自动请求该域名下的 /socket.io。
VUE_APP_SOCKET_URL=https://socket.siyes.cn

# 聊天历史会追加 /api/chat/messages。
VUE_APP_CHAT_HISTORY_API_BASE_URL=https://linux-api.siyes.cn

# 日志查询会追加 /api/logs/query。
VUE_APP_LOG_SERVER_BASE_URL=https://linux-api.siyes.cn
