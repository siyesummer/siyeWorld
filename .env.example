# 浏览器配置已经按 Vue CLI 模式拆分并提交到仓库：
# - yarn serve 自动读取 .env.development
# - yarn build 自动读取 .env.production
# - yarn build:pages 自动读取 .env.pages
# - GitHub Actions 前端镜像发布也读取 .env.production
#
# 本文件只记录变量清单，不参与构建。个人临时覆盖可以使用不提交的
# .env.development.local、.env.production.local 或 .env.pages.local，完成验证后应及时删除，避免覆盖标准配置。

VUE_APP_MUSIC_API_BASE_URL=
VUE_APP_SOCKET_URL=
VUE_APP_CHAT_HISTORY_API_BASE_URL=
VUE_APP_LOG_SERVER_BASE_URL=
VUE_APP_PUBLIC_PATH=
VUE_APP_ROUTER_MODE=
